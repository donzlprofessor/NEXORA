# Vite proxies /api to the loopback-only backend in development and preview.
NEXORA_BACKEND_URL=http://127.0.0.1:8000
# Separately deployed frontend: use a same-site HTTPS API origin, or a same-origin /api reverse proxy.
VITE_API_BASE_URL=
# Static showcase with no backend/inference calls:
VITE_PUBLIC_DEMO=false
