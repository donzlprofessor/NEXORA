OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
AI_TIMEOUT_SECONDS=120
# Account mode: provide a PostgreSQL URL after starting Compose and applying Alembic.
# URL-encode reserved characters in the password.
DATABASE_URL=postgresql+psycopg://nexora:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/nexora
COOKIE_SECURE=false
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
ALLOWED_HOSTS=127.0.0.1,localhost
# Set to disabled for a public demo. Never expose Ollama on a public interface.
AI_MODE=local
